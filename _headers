# HSTS matches the API's value (SecurityHeaders.HSTS_VALUE in coff-backend).
# includeSubDomains is safe because every web host under the apex is HTTPS:
# www, api and cdn (all proxied), per the CT log and DNS on 2026-09-25; send
# is mail-only, and there is no wildcard record. A new subdomain must serve
# HTTPS from day one. "preload" is left out on purpose: joining the browser
# preload list is an owner decision that takes months to undo.
#
# CSP allows no inline script or style: every page's code lives in /assets/css and /assets/js.
# 'self' also covers what Cloudflare adds at the edge: Email Obfuscation's
# /cdn-cgi/scripts/.../email-decode.min.js and Speed Brain's /cdn-cgi/speculation.
# connect-src names the API that /reset-password and /verify-email post to.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self' https://api.coffcircle.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'

# Apple requires the AASA file served as application/json with no redirects.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# Android's App Links verifier wants the same shape: application/json, no redirects.
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# Images and fonts never change under the same name. Stylesheets and scripts
# get their own rules below; a broad /assets/* rule here would be merged into
# theirs by Cloudflare and make them immutable too.
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Code changes must propagate quickly; images and fonts stay immutable above.
# Keep bumping ?v=N on link/script tags when a stylesheet or script changes.
/assets/css/*
  Cache-Control: public, max-age=300, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=300, must-revalidate

/favicon.ico
  Content-Type: image/x-icon
  Cache-Control: public, max-age=31536000, immutable

/favicon-filled.ico
  Content-Type: image/x-icon
  Cache-Control: public, max-age=31536000, immutable

/favicon-tab.ico
  Content-Type: image/x-icon
  Cache-Control: public, max-age=31536000, immutable

/favicon.png
  Cache-Control: public, max-age=31536000, immutable

/assets/img/favicon-filled.png
  Cache-Control: public, max-age=31536000, immutable

/assets/img/favicon-tab.png
  Cache-Control: public, max-age=31536000, immutable

/assets/img/favicon-bw-v1.svg
  Cache-Control: public, max-age=31536000, immutable

/assets/img/favicon-bw-v1.png
  Cache-Control: public, max-age=31536000, immutable

/favicon-bw-v1.ico
  Content-Type: image/x-icon
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon.png
